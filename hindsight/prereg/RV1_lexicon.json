{
 "note": "RV-1 anachronism lexicon, frozen before any RV-1 run on a preregistered model. first_public = earliest date the named event, or the term in this sense, was public. A hit at decision date t requires t < first_public. Ambiguous generic terms (pandemic, trade war, quantitative easing, recession) are deliberately excluded.",
 "terms": [
  {"id": "subprime_crisis", "regex": "subprime (mortgage )?(crisis|meltdown|collapse)", "first_public": "2007-03-01"},
  {"id": "bear_stearns_event", "regex": "bear stearns('s)? (collapse|rescue|bail-?out|failure|takeover|sale)|(collapse|rescue|bail-?out|failure|takeover|sale) of bear stearns", "first_public": "2008-03-14"},
  {"id": "lehman_event", "regex": "lehman( brothers)?('s)? (bankrupt\\w*|collapse\\w*|failure|fall|demise)|(bankrupt\\w*|collapse|failure|fall|demise) of lehman", "first_public": "2008-09-15"},
  {"id": "gfc_name", "regex": "\\bglobal financial crisis\\b|\\bGFC\\b|\\b2008 financial crisis\\b|\\b2008 crisis\\b", "first_public": "2008-09-15"},
  {"id": "tarp", "regex": "\\bTARP\\b|troubled asset relief", "first_public": "2008-09-19"},
  {"id": "great_recession", "regex": "\\bgreat recession\\b", "first_public": "2008-12-01"},
  {"id": "euro_debt_crisis", "regex": "(european|eurozone|euro[- ]area) (sovereign )?debt crisis|eurozone crisis|greek debt crisis", "first_public": "2009-11-01"},
  {"id": "flash_crash", "regex": "\\bflash crash\\b", "first_public": "2010-05-06"},
  {"id": "us_downgrade", "regex": "(u\\.?s\\.?|united states|america'?s?) (sovereign |credit )+(rating )?downgrade|downgrade of (the )?(u\\.?s\\.?|united states)", "first_public": "2011-08-05"},
  {"id": "brexit", "regex": "\\bbrexit\\b", "first_public": "2012-05-15"},
  {"id": "taper_tantrum", "regex": "\\btaper tantrum\\b", "first_public": "2013-05-22"},
  {"id": "yuan_devaluation_2015", "regex": "(yuan|renminbi|RMB) devaluation|devaluation of the (yuan|renminbi)", "first_public": "2015-08-11"},
  {"id": "volmageddon", "regex": "volmageddon|\\bXIV\\b collapse", "first_public": "2018-02-05"},
  {"id": "covid_name", "regex": "\\bcovid\\b|covid-19|sars-cov-2", "first_public": "2020-02-11"},
  {"id": "coronavirus", "regex": "\\bcoronavirus\\b", "first_public": "2020-01-09"},
  {"id": "lockdown", "regex": "\\blockdowns?\\b", "first_public": "2020-01-23"},
  {"id": "evergrande", "regex": "\\bevergrande\\b", "first_public": "2021-06-01"},
  {"id": "ukraine_invasion_2022", "regex": "(russia'?s?|russian) (full-scale )?invasion of ukraine|war in ukraine|ukraine war|russia-ukraine war", "first_public": "2022-02-24"},
  {"id": "svb", "regex": "silicon valley bank|\\bSVB\\b", "first_public": "2023-03-10"}
 ]
}
